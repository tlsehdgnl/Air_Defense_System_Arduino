/*
 * [단위 테스트] 서보모터 (SG90)
 * -----------------------------------------------
 * 팀명 : 뚝@딱
 * 조원 : 신동휘, 윤태웅, 이종현
 * -----------------------------------------------
 * 핀 연결:
 *   VCC    → 5V (전류 부족 시 외부 전원 고려)
 *   GND    → GND
 *   Signal → 디지털 9번 (주황선)
 * -----------------------------------------------
 * 동작 설명:
 *   레이더의 스캐닝 동작을 구현하기 위해
 *   0도 → 90도 → 180도 순서로 1초 간격으로 회전시킨다.
 *   모터가 떨림 없이 지정된 각도로 정확히 이동하는지 확인한다.
 * -----------------------------------------------
 * 테스트 결과: 정상 동작 확인
 */

#include <Servo.h>

Servo myServo;

void setup() {
  myServo.attach(9);
}

void loop() {
  // 0도 이동
  myServo.write(0);
  delay(1000);

  // 90도 이동 (정면)
  myServo.write(90);
  delay(1000);

  // 180도 이동
  myServo.write(180);
  delay(1000);
}
